{
    "name": "rechly-desktop",
    "productName": "Rechly",
    "version": "1.2.0",
    "description": "Rechly – Rechnungssoftware für Freelancer und kleine Unternehmen (Desktop)",
    "main": "out/main.js",
    "author": "Rechly",
    "license": "AGPL-3.0-only",
    "homepage": "https://rechly.de",
    "repository": {
        "type": "git",
        "url": "https://github.com/myaxyo/rechly_desktop.git"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "npm run build && electron .",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "dist:mac": "npm run build && electron-builder --mac",
        "dist:win": "npm run build && electron-builder --win",
        "postinstall": "electron-builder install-app-deps",
        "test": "npm run build && node scripts/run-unit-tests.cjs"
    },
    "dependencies": {
        "better-sqlite3": "13.0.3",
        "electron-updater": "^6.3.9",
        "ical.js": "2.2.1"
    },
    "devDependencies": {
        "@electron/osx-sign": "1.3.1",
        "@types/better-sqlite3": "7.6.13",
        "@types/node": "^20.19.43",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "typescript": "^7.0.2"
    }
}
